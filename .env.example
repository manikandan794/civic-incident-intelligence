# =================================================================
# URBANGRID ENVIRONMENT CONFIGURATION (.env.example)
# =================================================================

# Server Configuration
PROJECT_NAME="URBANGRID Civic Operations Platform"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL="postgresql+psycopg://postgres@127.0.0.1:5432/urbangrid"

# Security / Authentication
JWT_SECRET="urbangrid-super-secret-jwt-key-competition-2026-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI API Configuration (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY=""

# Civic Settings
DEFAULT_DUPLICATE_RADIUS_METERS=50.0
TAMIL_NADU_CENTER_LAT=13.0827
TAMIL_NADU_CENTER_LNG=80.2707

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"
