# =================================================================
# URBANGRID ENVIRONMENT CONFIGURATION (.env.example)
# Production Deployment Template (Placeholders Only - Never commit real secrets)
# =================================================================

# Server & Runtime Configuration
PROJECT_NAME="URBANGRID Civic Operations Platform"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / PostGIS)
# Example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL="postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>"

# Security & Authentication (JWT Secret)
JWT_SECRET="<GENERATE_SECURE_RANDOM_SECRET_KEY>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini Vision AI API Configuration (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Municipal Spatial Parameters
DEFAULT_DUPLICATE_RADIUS_METERS=50.0
TAMIL_NADU_CENTER_LAT=13.0827
TAMIL_NADU_CENTER_LNG=80.2707

# Frontend Origin & CORS Settings
FRONTEND_URL="https://<YOUR_RENDER_FRONTEND_URL>.onrender.com"
CORS_ORIGINS="https://<YOUR_RENDER_FRONTEND_URL>.onrender.com,http://localhost:5173,http://127.0.0.1:5173"

# Frontend Environment Variable (Set in Render Static Site Dashboard)
# VITE_API_URL="https://<YOUR_RENDER_BACKEND_URL>.onrender.com"
